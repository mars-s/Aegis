{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegis",
  "version": "0.1.0",
  "identifier": "app.aegis.canvas",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix app run dev",
    "beforeBuildCommand": "npm --prefix app run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aegis",
        "width": 1440,
        "height": 900,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src http://127.0.0.1:* https://open.spotify.com"
    }
  },
  "bundle": {
    "macOS": { "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" },
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "A minimal canvas for you and your agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agent/server.mjs": "agent/server.mjs",
      "../agent/mcp.mjs": "agent/mcp.mjs",
      "../agent/mcp-config.mjs": "agent/mcp-config.mjs",
      "../agent/mcp-content.mjs": "agent/mcp-content.mjs",
      "../plugins/aegis": "plugins/aegis",
      "../app/src/features/docs/content.js": "app/src/features/docs/content.js",
      "../app/src/objects/kinds/html-sandbox.js": "app/src/objects/kinds/html-sandbox.js",
      "../app/src/objects/kinds/html-theme.js": "app/src/objects/kinds/html-theme.js",
      "../agent/status.mjs": "agent/status.mjs",
      "../app/src/features/media/link-preview.mjs": "app/src/features/media/link-preview.mjs",
      "../agent/package.json": "agent/package.json",
      "../agent/node_modules": "agent/node_modules",
      "../agent/library.mjs": "agent/library.mjs",
      "../app/src/lib/board": "app/src/lib/board",
      "../agent/ui-update.mjs": "agent/ui-update.mjs",
      "../agent/skills": "agent/skills"
    }
  }
}
