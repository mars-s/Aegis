{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "vitest.config.ts",
    "checks/unit/domain/**/*.ts",
    "checks/support/**/*.ts",
    "checks/unit/**/*.ts",
    "app/vite.config.ts"
  ]
}
