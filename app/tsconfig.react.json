{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/composition.tsx",
    "src/workspace/**/*.ts",
    "src/canvas/**/*.tsx",
    "src/canvas/**/*.ts",
    "src/platform/**/*.ts",
    "src/cards/**/*.tsx",
    "src/charts/**/*.ts",
    "src/charts/**/*.tsx",
    "src/editors/sheet/**/*.tsx",
    "src/editors/dataset/**/*.ts",
    "src/editors/dataset/**/*.tsx",
    "src/features/data/**/*.ts",
    "src/features/data/**/*.tsx",
    "src/platform/**/*.tsx",
    "src/chrome/**/*.ts",
    "src/chrome/**/*.tsx",
    "src/editors/**/*.ts",
    "src/editors/**/*.tsx",
    "src/features/agents/**/*.ts",
    "src/features/agents/**/*.tsx",
    "src/features/first-minute/**/*.tsx",
    "src/features/settings/**/*.ts",
    "src/features/settings/**/*.tsx",
    "src/features/onboarding/**/*.tsx",
    "src/features/mobile/**/*.tsx",
    "src/features/editing/**/*.tsx"
  ]
}
